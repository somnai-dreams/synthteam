{
  "name": "synthteam",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:app && bun run build:streamdeck",
    "build:app": "bun build --target=bun --outdir=dist src/server/index.ts",
    "build:streamdeck": "bun build --target=node --outdir=dist/streamdeck hardware/streamdeck/com.synthteam.deck.sdPlugin/plugin.mjs",
    "check": "bun tsc && bun oxlint --type-aware --deny-warnings src scripts",
    "dev": "bun --hot src/server/index.ts",
    "probe:midi": "xcrun swift -module-cache-path /tmp/synthteam-swift-module-cache scripts/probe-midi.swift",
    "probe:uf8": "bun scripts/probe-uf8.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@somnai-dreams/ableton-push": "git+https://github.com/somnai-dreams/ableton-push.git#v0.1.0",
    "@somnai-dreams/ssl-uf8": "git+https://github.com/somnai-dreams/ssl-uf8.git#v0.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "@julusian/midi",
    "usb"
  ]
}
