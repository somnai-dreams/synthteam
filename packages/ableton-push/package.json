{
  "name": "@somnai-dreams/ableton-push",
  "version": "0.1.0",
  "description": "Bun driver for Ableton Push MIDI controls, LEDs, and display",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somnai-dreams/ableton-push.git"
  },
  "bugs": {
    "url": "https://github.com/somnai-dreams/ableton-push/issues"
  },
  "homepage": "https://github.com/somnai-dreams/ableton-push#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "check": "bun tsc && bun oxlint --type-aware --deny-warnings src test",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun test"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.0",
    "@types/w3c-web-usb": "^1.0.14",
    "usb": "^2.16.0"
  },
  "trustedDependencies": [
    "@julusian/midi",
    "usb"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ableton",
    "push",
    "midi",
    "control-surface",
    "bun"
  ]
}
