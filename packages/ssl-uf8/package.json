{
  "name": "@somnai-dreams/ssl-uf8",
  "version": "0.1.0",
  "description": "Bun driver for direct SSL UF8 displays, faders, and motor control",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somnai-dreams/ssl-uf8.git"
  },
  "bugs": {
    "url": "https://github.com/somnai-dreams/ssl-uf8/issues"
  },
  "homepage": "https://github.com/somnai-dreams/ssl-uf8#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "PROTOCOL.md",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "check": "bun tsc && bun oxlint --type-aware --deny-warnings src test",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ssl",
    "uf8",
    "control-surface",
    "motor-fader",
    "bun"
  ]
}
